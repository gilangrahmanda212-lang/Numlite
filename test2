% =======================================================
% UJI FITUR BILANGAN KOMPLEKS HINGGA KONSTANTA PI
% =======================================================

% 1. UJI KONSTANTA PI
p = pi

% 2. UJI TRIGONOMETRI INVERS
% asin(1) harusnya pi/2 (1.5708)
as1 = asin(1)
% acos(0) harusnya pi/2 (1.5708)
ac1 = acos(0)
% atan(1) harusnya pi/4 (0.7854)
at1 = atan(1)

% 3. UJI FUNGSI SIGN (Tanda)
% Hasilnya harus 1, -1, dan 0
sg_pos = sign(10)
sg_neg = sign(-5)
sg_zero = sign(0)

% 4. UJI BILANGAN KOMPLEKS
% Membuat bilangan kompleks (3 + 4i) dan (1 - 2i)
z1 = complex(3, 4)
z2 = complex(1, -2)

% Mengambil bagian riil dan imajiner
r1 = real(z1)
i1 = imag(z1)

% Mencari konjugat, magnitudo, dan fase
k1 = conj(z1)
m1 = abs(z1)
f1 = angle(z1)

% UJI CAMPURAN (Kompleks & Trigonometri)
% Operasi akar dari bilangan negatif (meski belum native complex, ini untuk tes)
% Tapi karena kita punya tipe data complex, kita bisa kombinasikan:
z_hasil = complex(cos(pi), sin(pi))